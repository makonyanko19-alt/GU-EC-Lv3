# ローカル開発用（Docker の MySQL）の設定例。
# コピーして .env を作り、パスワードを自分で決めた値に変更する。.env はコミットしない。
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=gu_ec_mako
MYSQL_USER=gu_app

# 運営のAzure MySQLを使う場合は、別ファイル .env.azure を作り、次の6項目を書く。
# .env.azure も .gitignore で除外されており、コミットしない。
# パスワードは引用符で囲まず、そのまま書く。
#   MYSQL_HOST=<サーバー名>.mysql.database.azure.com
#   MYSQL_PORT=3306
#   MYSQL_DATABASE=gu_ec_mako
#   MYSQL_USER=<運営から共有されたユーザー名>
#   MYSQL_PASSWORD=<運営から共有されたパスワード>
#   MYSQL_SSL=true
# 起動前に $env:APP_ENV_FILE = ".env.azure" を指定すると、APIがAzureへ接続する。
